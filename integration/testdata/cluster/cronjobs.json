{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "nightly",
        "namespace": "prod",
        "uid": "00000000-0000-0000-0000-0000000000f0",
        "creationTimestamp": "2026-01-02T00:00:00Z"
      },
      "spec": {
        "schedule": "0 3 * * *",
        "jobTemplate": {
          "spec": {
            "template": {
              "metadata": {"labels": {"cronjob": "nightly"}},
              "spec": {
                "restartPolicy": "Never",
                "containers": [
                  {
                    "name": "report",
                    "image": "registry.example.com/report:2.0.0",
                    "livenessProbe": {
                      "exec": {"command": ["/bin/sh", "-c", "test -f /tmp/alive"]},
                      "initialDelaySeconds": 60,
                      "periodSeconds": 30,
                      "failureThreshold": 3
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
