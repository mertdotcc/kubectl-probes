{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "argoproj.io/v1alpha1",
      "kind": "Rollout",
      "metadata": {
        "name": "checkout",
        "namespace": "prod",
        "uid": "00000000-0000-0000-0000-000000000090",
        "creationTimestamp": "2026-02-11T13:00:00Z",
        "labels": {"app": "checkout"}
      },
      "spec": {
        "replicas": 1,
        "strategy": {"canary": {"steps": [{"setWeight": 20}, {"pause": {}}]}},
        "selector": {"matchLabels": {"app": "checkout"}},
        "template": {
          "metadata": {"labels": {"app": "checkout"}},
          "spec": {
            "containers": [
              {
                "name": "checkout",
                "image": "registry.example.com/checkout:5.0.0",
                "ports": [{"name": "grpc", "containerPort": 9000, "protocol": "TCP"}],
                "readinessProbe": {
                  "grpc": {"port": 9000, "service": "checkout.Health"},
                  "periodSeconds": 10,
                  "timeoutSeconds": 15,
                  "failureThreshold": 3
                }
              }
            ]
          }
        }
      }
    }
  ]
}
